{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"fit-vlad-local",
  "main":"src/server.ts",
  "compatibility_date":"2026-10-13",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":false,
  "preview_urls":false,
  "d1_databases":[{"binding":"DB","database_name":"fit-local","database_id":"00000000-0000-0000-0000-000000000001","migrations_dir":"migrations","remote":false}],
  "vars":{"BETTER_AUTH_URL":"http://127.0.0.1:3001","APP_ENV":"local","OTP_DELIVERY":"local-log"}
}
